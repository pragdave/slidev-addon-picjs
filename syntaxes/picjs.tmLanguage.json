{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "picjs",
  "scopeName": "source.picjs",
  "fileTypes": ["picjs", "pic"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#color" },
    { "include": "#hexcolor" },
    { "include": "#number" },
    { "include": "#animation" },
    { "include": "#keyword" },
    { "include": "#shape" },
    { "include": "#command" },
    { "include": "#attribute" },
    { "include": "#builtin" },
    { "include": "#direction" },
    { "include": "#cardinal" },
    { "include": "#variable" },
    { "include": "#self" },
    { "include": "#inspect" },
    { "include": "#arrow" },
    { "include": "#operator" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.double-slash.picjs",
      "match": "//.*"
    },
    "string": {
      "patterns": [
        { "name": "string.quoted.triple.picjs", "begin": "\"\"\"", "end": "\"\"\"" },
        { "name": "string.quoted.triple.picjs", "begin": "'''", "end": "'''" },
        {
          "name": "string.quoted.double.picjs",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.picjs", "match": "\\\\." },
            {
              "name": "meta.interpolation.picjs",
              "begin": "#\\{",
              "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.picjs" } },
              "end": "\\}",
              "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.picjs" } },
              "patterns": [{ "name": "variable.other.interpolation.picjs", "match": "[^}]+" }]
            }
          ]
        },
        {
          "name": "string.quoted.single.picjs",
          "begin": "'",
          "end": "'",
          "patterns": [{ "name": "constant.character.escape.picjs", "match": "\\\\." }]
        }
      ]
    },
    "color": {
      "name": "constant.other.color.picjs",
      "match": "~[a-zA-Z]\\w*(?:\\.\\w+(?:\\([^)]*\\))?)*"
    },
    "hexcolor": {
      "name": "constant.other.color.hex.picjs",
      "match": "#[0-9A-Fa-f]{3,8}\\b"
    },
    "number": {
      "name": "constant.numeric.picjs",
      "match": "\\b\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?%?"
    },
    "animation": {
      "name": "keyword.control.animation.picjs",
      "match": "\\b(?:draw|move|pause|rotate|set|then)\\b"
    },
    "keyword": {
      "name": "keyword.other.picjs",
      "match": "\\b(?:if|else|true|false|same|from|to|with|at|behind|above|below|inside|outside|close|about|by|until|even|level)\\b"
    },
    "shape": {
      "name": "entity.name.type.shape.picjs",
      "match": "\\b(?:Arc|Aside|Box|Circle|Ellipse|Gap|Goto|Group|Line|Label|Oval|Shape|Skip|arc|box|circle|ellipse|line|oval)\\b"
    },
    "command": {
      "name": "support.class.picjs",
      "match": "\\b(?:Face|Palette)\\b"
    },
    "attribute": {
      "name": "entity.other.attribute-name.picjs",
      "match": "\\b(?:fill|stroke|stroke_width|thickness|thick|width|wid|height|ht|radius|rad|rx|ry|rotation|rot|opacity|dashed|dotted|solid|straight|smooth|stepped|step|curved|curve|length|len|align|fit|maxwidth|nodraw|font|font_family|font_size|font_style|font_weight|font_variant|font_stretch|line_height|cw|ccw|turn|take|ease)\\b"
    },
    "builtin": {
      "name": "support.function.builtin.picjs",
      "match": "\\b(?:sin|cos|tan|asin|acos|atan2|polar|d2r|r2d|ln|log10|push|pop|map|filter|sort|has|length|times|each)\\b"
    },
    "direction": {
      "name": "constant.language.direction.picjs",
      "match": "\\b(?:north|northeast|northwest|south|southeast|southwest|east|west|up|down|left|right)\\b"
    },
    "cardinal": {
      "name": "constant.language.cardinal.picjs",
      "match": "\\b(?:[ns][ew]?|[ew]|c)\\b(?=\\s)"
    },
    "variable": {
      "name": "variable.other.picjs",
      "match": "\\$\\w+"
    },
    "self": {
      "name": "variable.language.self.picjs",
      "match": "\\bself\\b"
    },
    "inspect": {
      "name": "keyword.operator.inspect.picjs",
      "match": "\\?\\?|@@"
    },
    "arrow": {
      "name": "keyword.operator.arrow.picjs",
      "match": "<->|=>|->|<-|<~|~>|--|~~"
    },
    "operator": {
      "name": "keyword.operator.picjs",
      "match": "[+\\-*/%^]=?|[=!<>]=|&&|\\|\\||!|@"
    },
    "punctuation": {
      "name": "punctuation.picjs",
      "match": "[{}()\\[\\],;.]"
    }
  }
}
